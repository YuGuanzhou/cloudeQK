<resources>
    <string name="app_name">小鱼 云群控</string>
    <color name="app_background">#08111F</color><color name="card_background_color">#111E31</color><color name="input_background_color">#0B1627</color>
    <color name="brand_blue">#1677FF</color><color name="brand_teal">#14D9C4</color><color name="text_primary">#F4F8FF</color><color name="text_secondary">#91A3BB</color>
    <color name="status_waiting">#F4B84A</color><color name="status_online">#28D79B</color><color name="status_offline">#FF6577</color>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/brand_teal</item><item name="android:navigationBarColor">@color/app_background</item><item name="android:statusBarColor">@color/app_background</item><item name="android:windowLightStatusBar">false</item></style>
    <style name="SectionLabel"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="ConfigInput"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:layout_marginTop">6dp</item><item name="android:background">@drawable/input_background</item><item name="android:paddingHorizontal">14dp</item><item name="android:textColor">@color/text_primary</item><item name="android:textColorHint">@color/text_secondary</item><item name="android:singleLine">true</item></style>
    <style name="PrimaryButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item><item name="android:backgroundTint">@color/brand_blue</item><item name="android:textColor">#FFFFFF</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item></style>
    <style name="SecondaryButton" parent="PrimaryButton"><item name="android:backgroundTint">#243955</item></style>
</resources>
